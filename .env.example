# OpenClaw Voice — environment template.
# Copy to .env and fill in real values. Never commit a filled-in .env.

XAI_API_KEY=your_xai_api_key
SIP_PASSWORD=your_sip_password
OPENCLAW_GATEWAY_TOKEN=your_openclaw_token

# Inbound PIN. Only used when auth.require_pin is true in config.yaml.
# The default is require_pin: false (no inbound PIN) — leave this blank then.
OPENCLAW_AUTH_PIN=
